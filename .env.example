# ═══════════════════════════════════════════════════════════════════
# Cryinder — environment template
#
# Two kinds of vars:
#   VITE_*   → baked into the JS bundle at BUILD time. Must be set in the
#              Vercel dashboard BEFORE each production build, and any change
#              requires a redeploy to take effect. Never put secrets here —
#              they ship to every browser.
#   PB_* / TURNSTILE_SECRET_KEY → read at RUNTIME by the serverless API
#              (api/pb.js). Never shipped to the browser. Safe for secrets.
# ═══════════════════════════════════════════════════════════════════

# ── Build-time (VITE_*) ─────────────────────────────────────────────

# Helius RPC key. REQUIRED in prod — without it the app falls back to the
# public RPC, which rate-limits instantly under real traffic.
VITE_HELIUS_API_KEY=

# Jupiter Swap API key (sent as x-api-key). REQUIRED in prod — api.jup.ag
# rate-limits keyless traffic.
VITE_JUPITER_API_KEY=

# Referral account collecting the 1% swap fee. Defaults are baked in as a
# fallback, but set these explicitly so a rebuild never surprises you.
VITE_JUPITER_REFERRAL_ACCOUNT=
VITE_JUPITER_REFERRAL_FEE_BPS=100
VITE_JUPITER_REFERRAL_ENABLED=true

# Treasury wallet shown in the UI (display only).
VITE_CRYINDER_TREASURY_PUBLIC_KEY=

# Cloudflare Turnstile site key (PUBLIC — safe for the bundle). Must match
# the widget hostname allowlist in the Cloudflare dashboard.
VITE_TURNSTILE_SITE_KEY=

# Optional: WalletConnect project id (https://cloud.walletconnect.com).
# Only needed for QR/deep-link mobile connects. Leave empty to disable.
VITE_WALLETCONNECT_PROJECT_ID=

# Privy app id (https://dashboard.privy.io). REQUIRED for Google/Apple
# social login in the auth modal — without it only extension wallets show.
# Solana embedded wallets are auto-provisioned on social login.
VITE_PRIVY_APP_ID=

# ── Runtime (serverless API only) ───────────────────────────────────

# Public HTTPS URL of your hosted PocketBase. Vercel cannot reach
# 127.0.0.1 — this MUST be an https:// URL, e.g. https://pb.cryinder.xyz
PB_URL=

# PocketBase superuser used ONLY server-side by api/pb.js (admin client
# never leaves the function). Use a dedicated strong password.
PB_ADMIN_EMAIL=
PB_ADMIN_PASSWORD=

# HMAC secret for wallet-session tokens. Generate with:
#   openssl rand -base64 48
# Must be identical across all deploys; rotating it logs everyone out.
PB_SESSION_SECRET=

# Cloudflare Turnstile secret key (server-side siteverify). NEVER prefix
# with VITE_ — it must never reach the browser.
TURNSTILE_SECRET_KEY=
